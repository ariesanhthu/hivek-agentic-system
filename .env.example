# HIVE-K Agentic System — configuration
#
# Copy to .env and fill in. EVERY value here is optional: with an empty file the
# service still boots on an in-memory store + mock LLM, and the whole chat flow runs.
# That is deliberate — a demo must never be blocked on infrastructure.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8100

# Browsers call this service directly from the Next.js client, so its origin must be
# allowed. Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Persistence — MongoDB (Atlas or self-hosted)
# ---------------------------------------------------------------------------
# Leave blank to use the in-memory store (nothing persists across restarts).
#
# NOTE: Atlas gives you a template containing the literal <db_password>. Replace it
# with the real password — the service detects the placeholder and refuses to treat it
# as a URI (it would otherwise fail at first query rather than at boot).
MONGODB_URI=
MONGODB_DB_NAME=hivek
MONGODB_TIMEOUT_MS=5000

# This service shares the database with the main backend and only ever touches its own
# `agentic_*` collections. It never reads or writes users/campaigns/influencers/etc.

# auto = mongo when a usable URI is set, else memory. Force with `memory` or `mongo`.
STORE_BACKEND=auto

# Atlas Vector Search index name (for semantic memory retrieval — see README roadmap).
BRAND_MEMORY_VECTOR_INDEX=brand_memory_vector_index

# ---------------------------------------------------------------------------
# Model gateway
# ---------------------------------------------------------------------------
# auto = gemini when GEMINI_API_KEY is set, else mock. Force with `mock` or `gemini`.
# `mock` is a deterministic fake — use it for tests, demos and offline work.
AI_AGENT_PROVIDER=auto

GEMINI_API_KEY=

# Free-tier keys frequently have a hard quota of 0 on Pro models while Flash works.
# The model router carries a fallback chain, so a Pro-tier task degrades to Flash
# instead of failing. If your key has no Pro access, just set both to Flash.
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRATEGY=gemini-2.5-pro
GEMINI_MODEL_VALIDATOR=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Run policy — hard ceilings per run (no unbounded agent loops)
# ---------------------------------------------------------------------------
MAX_STEPS_PER_RUN=24
MAX_TOOL_CALLS_PER_RUN=32
DEFAULT_TOKEN_BUDGET=12000

# ---------------------------------------------------------------------------
# Source-specific Meta demo
# ---------------------------------------------------------------------------
# `mock` never contacts Meta. `sandbox` and `live` both use the real provider
# transport; keep the label visible in the client so demo data is never ambiguous.
SOCIAL_MODE=mock
INBOUND_MODE=polling
AUTO_REPLY_MODE=suggestion
AUTO_REPLY_MIN_CONFIDENCE=0.90
AUTO_REPLY_ALLOWED_INTENTS=greeting,ask_location,ask_basic_process

# Must match the workspace and server-only secrets configured in apps/client.
DEMO_WORKSPACE_ID=demo_workspace
AGENTIC_DEMO_ACCESS_TOKEN=
AGENTIC_INTERNAL_SECRET=

# Same 32-byte base64 key used by the Next.js credential vault. Never use a
# NEXT_PUBLIC_ variable for this value.
TOKEN_ENCRYPTION_KEY_BASE64=

META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_SECRET=
THREADS_API_BASE_URL=https://graph.threads.net
THREADS_API_VERSION=
THREADS_APP_SECRET=
PROVIDER_HTTP_TIMEOUT_SECONDS=20
PROVIDER_MAX_RETRIES=2

WEBHOOK_VERIFY_TOKEN=
WEBHOOK_SIGNATURE_REQUIRED=true
